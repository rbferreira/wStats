{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wStats",
  "version": "0.3.1",
  "identifier": "dev.rafalab.wstats",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Rafael Ferreira",
    "copyright": "© 2026 Rafael Ferreira",
    "category": "Utility",
    "shortDescription": "Monitor de sistema na barra de tarefas do Windows",
    "longDescription": "CPU, GPU, memória, discos, rede, bateria, temperatura, ventoinhas e consumo de energia dentro da barra de tarefas, com painéis detalhados a um clique.",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
